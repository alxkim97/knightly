{
  "name": "knightly",
  "version": "2.3.0",
  "description": "Knightly — learn chess, solve puzzles and play the computer. Web app (PWA) and Windows desktop app from one codebase.",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "start": "vite build && electron .",
    "electron:build": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win --x64",
    "build:win": "npm run electron:build",
    "fetch-puzzles": "node scripts/fetch-puzzles.js",
    "build-lessons": "node scripts/build-lessons.js",
    "build-icon": "node scripts/build-icon.js",
    "build-course": "node scripts/build-course.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "chess.js": "^1.0.0-beta.8",
    "electron": "^42.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.apm.knightly",
    "productName": "Knightly",
    "copyright": "Copyright © 2026 Alex · APm R&D",
    "files": [
      "main.js",
      "preload.js",
      "preload-mini.js",
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Knightly"
    }
  }
}
